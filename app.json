{
  "expo": {
    "name": "WakeMATE",
    "slug": "wakemate-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "NHGT3Q6R85",
      "bundleIdentifier": "com.anonymous.wakematemobile",
      "buildNumber": "2",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.anonymous.wakematemobile"
        ]
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "WakeMATE needs local network access to discover your computer and send Wake-on-LAN packets.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.wakematemobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WakeMATE to scan QR codes for your pairing token.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@bacons/apple-targets",
      "./plugins/withIosOnlyProject",
      "./plugins/withPhysicalDeviceDebugBundle",
      "./plugins/withIosBuildSettings",
      "./plugins/withXcodeCloudScripts",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
